# Get a free API key at https://app.brevo.com/settings/keys/api (300 emails/day free)
BREVO_API_KEY=your-brevo-api-key
# Sender address: use the email you signed up to Brevo with (it is a verified sender by default)
MAIL_FROM_EMAIL=your-email@example.com
MAIL_FROM_NAME=DriveFusion
SESSION_SECRET=some-long-random-string
APP_ORIGIN=http://localhost:5173
PORT=4040

# MongoDB Atlas (Atlas -> Connect -> Drivers). NEVER commit the real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
DB_NAME=drivefusion

# Secret for the admin-only GET /api/users route (sent back as the
# x-admin-key header). Pick any long random string. NEVER commit the real value.
ADMIN_KEY=some-long-random-admin-key
